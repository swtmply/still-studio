# The Vercel Blob store connection supplies credentials automatically.
# Never put credentials in NEXT_PUBLIC_ variables or commit .env.local.
# Dashboard sessions need a randomly generated secret of at least 32 characters.
# INK_ADMIN_TOKEN=
# Optional private 8–16 digit PIN. Without it, the dashboard uses the admin token.
# INK_ADMIN_PIN=

# Force local Wi-Fi sharing when running the app on the booth:
# SHARE_MODE=local
# SHARE_HOST=192.168.1.10
